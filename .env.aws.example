# Copy this file to .env.aws on the EC2 instance and replace every placeholder.
# Never commit .env.aws or real production credentials.

SPRING_DATASOURCE_URL=jdbc:postgresql://your-rds-endpoint.region.rds.amazonaws.com:5432/releasepilot
SPRING_DATASOURCE_USERNAME=replace-with-rds-username
SPRING_DATASOURCE_PASSWORD=replace-with-rds-password
RELEASEPILOT_INGESTION_TOKEN=replace-with-a-long-random-token
FRONTEND_ORIGIN=http://YOUR_EC2_PUBLIC_IP:3000
NEXT_PUBLIC_API_BASE_URL=http://YOUR_EC2_PUBLIC_IP:8080
